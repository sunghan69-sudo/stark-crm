rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 管理員帳號
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'sunghan69@gmail.com';
    }
    function signedIn(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // 已開通（輸入過正確確認碼、且未被停用）
    function isMember(uid) {
      return exists(/databases/$(database)/documents/members/$(uid))
        && get(/databases/$(database)/documents/members/$(uid)).data.active == true;
    }

    // 每個帳號只能讀寫自己的資料；內測期間必須先開通
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn(uid) && (isAdmin() || isMember(uid));
    }

    // 共用商品庫：已開通帳號都能讀，只有管理員能新增／修改
    match /products/{id} {
      allow read: if request.auth != null && (isAdmin() || isMember(request.auth.uid));
      allow write: if isAdmin();
    }

    // 各帳號回報「待補商品」（只有商品名稱，不含客戶資料）；管理員彙整
    match /prodNeeds/{uid} {
      allow read: if isAdmin() || signedIn(uid);
      allow write: if signedIn(uid) && (isAdmin() || isMember(uid));
    }

    // 加入申請：本人送出、管理員覆核
    match /applications/{uid} {
      allow read: if isAdmin() || signedIn(uid);
      allow create: if signedIn(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin()
        || (signedIn(uid) && resource.data.status == 'rejected' && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // 確認碼：只有管理員看得到
    match /codes/{uid} {
      allow read, write: if isAdmin();
    }

    // 忘記密碼申請：未登入也能送出；申請內容（姓名／email／電話）只有管理員看得到
    match /resetRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email','name','phone','status','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.name is string && request.resource.data.name.size() <= 50
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
      allow get, list, delete: if isAdmin();
      // 申請人用確認碼把「已核准」改成「已使用」：確認碼必須和管理員存在 resetCodes 的一致
      allow update: if isAdmin()
        || (resource.data.status == 'approved' && request.resource.data.status == 'used'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','usedAt','code'])
            && exists(/databases/$(database)/documents/resetCodes/$(id))
            && request.resource.data.code == get(/databases/$(database)/documents/resetCodes/$(id)).data.code);
    }
    // 重設密碼確認碼：只有管理員能讀寫
    match /resetCodes/{id} {
      allow read, write: if isAdmin();
    }

    // 開通紀錄：本人輸入的確認碼必須和管理員產生的一致
    match /members/{uid} {
      allow read: if isAdmin() || signedIn(uid);
      allow create: if signedIn(uid)
        && exists(/databases/$(database)/documents/codes/$(uid))
        && request.resource.data.code == get(/databases/$(database)/documents/codes/$(uid)).data.code
        && request.resource.data.active == true;
      allow update, delete: if isAdmin();
    }
  }
}
